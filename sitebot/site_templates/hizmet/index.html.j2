{% import "_shared/parts.html.j2" as p with context %}
{% set extra %}
.hero{position:relative;min-height:min(100svh,880px);display:grid;align-items:center;
  padding-top:100px;overflow:hidden}
.hero-bg{position:absolute;inset:0;z-index:-2}
.hero-bg img{width:100%;height:100%;object-fit:cover}
.hero-bg::after{content:"";position:absolute;inset:0;
  background:linear-gradient(105deg,
    color-mix(in srgb,var(--bg) {{ banner.overlay + 30 }}%,transparent) 0%,
    color-mix(in srgb,var(--bg) {{ banner.overlay }}%,transparent) 55%,
    color-mix(in srgb,var(--bg) {{ [banner.overlay - 25, 0]|max }}%,transparent) 100%)}
.mesh{position:absolute;inset:-30% -10%;z-index:-3;pointer-events:none;
  background:
    radial-gradient(42% 46% at 12% 22%,rgba(var(--primary-rgb),.42),transparent 62%),
    radial-gradient(38% 42% at 84% 14%,rgba(var(--accent-rgb),.34),transparent 60%),
    radial-gradient(46% 50% at 62% 88%,rgba(var(--primary-rgb),.22),transparent 65%);
  filter:blur(28px);animation:drift 22s ease-in-out infinite alternate}
@keyframes drift{to{transform:translate3d(-3%,2%,0) scale(1.08)}}
.hero-in{max-width:820px}
.hero h1{margin:0 0 20px}
.hero h1 .hl{background:linear-gradient(120deg,var(--primary),var(--accent));
  -webkit-background-clip:text;background-clip:text;color:transparent}
.hero .sub{font-size:clamp(1.05rem,1.7vw,1.3rem);color:var(--muted);max-width:60ch;margin-bottom:34px}
.cta{display:flex;gap:14px;flex-wrap:wrap}
.badge-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:38px}
.badge-row span{font-size:.82rem;font-weight:700;padding:8px 15px;border-radius:999px;
  border:1px solid var(--border);background:color-mix(in srgb,var(--surface) 70%,transparent);
  backdrop-filter:blur(8px)}

.marquee{overflow:hidden;border-block:1px solid var(--border);
  background:var(--surface);padding:16px 0;-webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent)}
.marquee ul{display:flex;gap:52px;list-style:none;width:max-content;animation:slide 26s linear infinite}
.marquee li{display:flex;align-items:center;gap:12px;font-weight:800;font-size:1.02rem;
  letter-spacing:-.02em;white-space:nowrap;color:var(--muted)}
.marquee li::before{content:"◆";color:var(--accent);font-size:.68rem}
@keyframes slide{to{transform:translateX(-50%)}}

.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
  gap:1px;background:var(--border);border:1px solid var(--border);border-radius:var(--r);overflow:hidden}
.stats div{background:var(--bg);padding:clamp(24px,3.4vw,42px) 22px;text-align:center}
.stats b{display:block;font-size:clamp(2.1rem,4.4vw,3.2rem);font-weight:900;letter-spacing:-.045em;
  background:linear-gradient(140deg,var(--primary),var(--accent));
  -webkit-background-clip:text;background-clip:text;color:transparent;line-height:1}
.stats span{font-size:.83rem;color:var(--muted);text-transform:uppercase;
  letter-spacing:.12em;font-weight:700;margin-top:8px;display:block}

.svc{padding:32px 28px 30px}
.svc .n{position:absolute;top:-14px;right:14px;font-size:5.4rem;font-weight:900;
  color:var(--fg);opacity:.05;line-height:1;letter-spacing:-.06em;pointer-events:none}
.svc .ic{width:56px;height:56px;border-radius:17px;display:grid;place-items:center;font-size:1.55rem;
  background:linear-gradient(140deg,rgba(var(--primary-rgb),.2),rgba(var(--accent-rgb),.16));
  border:1px solid var(--border);margin-bottom:18px}
.svc h3{margin-bottom:9px}
.svc p{color:var(--muted);font-size:.96rem}
.svc img{width:100%;height:160px;object-fit:cover;border-radius:var(--r-sm);margin-bottom:18px}
.svc::after{content:"";position:absolute;left:0;right:0;bottom:0;height:3px;
  background:linear-gradient(90deg,var(--primary),var(--accent));
  transform:scaleX(0);transform-origin:left;transition:transform .35s cubic-bezier(.2,.8,.2,1)}
.svc:hover::after{transform:scaleX(1)}

.split{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(28px,5vw,72px);align-items:center}
@media(max-width:900px){.split{grid-template-columns:1fr}}
.split-img{border-radius:var(--r-lg);overflow:hidden;position:relative;box-shadow:var(--shadow-lg)}
.split-img img{width:100%;aspect-ratio:4/3;object-fit:cover}
.split-img::before{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;
  background:linear-gradient(160deg,transparent 55%,rgba(var(--primary-rgb),.28))}

.band{position:relative;overflow:hidden;border-radius:var(--r-lg);
  padding:clamp(38px,6vw,76px) clamp(26px,5vw,64px);text-align:center;
  background:linear-gradient(125deg,var(--primary),var(--accent));color:var(--on-primary)}
.band::before{content:"";position:absolute;inset:0;opacity:.16;
  background:radial-gradient(60% 90% at 82% 12%,#fff,transparent 60%)}
.band > *{position:relative}
.band h2{margin-bottom:14px}
.band p{opacity:.9;max-width:56ch;margin:0 auto 30px}
.band .btn{--btn-bg:var(--bg);--btn-fg:var(--fg);box-shadow:0 14px 34px -14px rgba(0,0,0,.6)}

.gal{columns:3 260px;column-gap:clamp(12px,1.6vw,20px)}
.gal figure{break-inside:avoid;margin-bottom:clamp(12px,1.6vw,20px);position:relative;
  border-radius:var(--r);overflow:hidden;border:1px solid var(--border)}
.gal img{width:100%;transition:transform .55s cubic-bezier(.2,.8,.2,1)}
.gal figure:hover img{transform:scale(1.06)}
.gal figcaption{position:absolute;inset:auto 0 0 0;padding:26px 16px 13px;font-size:.9rem;font-weight:600;
  color:#fff;background:linear-gradient(transparent,rgba(0,0,0,.82));opacity:0;transition:opacity .3s}
.gal figure:hover figcaption{opacity:1}

.plist{display:grid;gap:clamp(14px,2vw,22px);
  grid-template-columns:repeat(auto-fill,minmax(min(100%,250px),1fr))}
.pcard{padding:0;display:flex;flex-direction:column}
.pcard .ph{aspect-ratio:4/3;overflow:hidden;background:var(--surface-2);position:relative}
.pcard .ph img{width:100%;height:100%;object-fit:cover;transition:transform .5s cubic-bezier(.2,.8,.2,1)}
.pcard:hover .ph img{transform:scale(1.07)}
.pcard .pb{padding:20px;display:flex;flex-direction:column;gap:7px;flex:1}
.pcard h3{font-size:1.06rem}
.pcard .desc{font-size:.9rem;color:var(--muted);flex:1}
.pcard .price{font-size:1.35rem;font-weight:900;letter-spacing:-.03em;color:var(--accent)}
.pcard .tag{position:absolute;top:12px;left:12px;z-index:2;font-size:.72rem;font-weight:800;
  padding:6px 12px;border-radius:999px;background:var(--accent);color:var(--on-accent);
  text-transform:uppercase;letter-spacing:.08em}
{% endset %}
<!DOCTYPE html>
<html lang="{{ site.lang or 'tr' }}">
<head>
{{ p.head(extra) }}
</head>
<body id="top">
{% set links = [] %}
{% if 'services' in sections %}{% set _ = links.append(('#hizmetler','Hizmetler')) %}{% endif %}
{% if 'about' in sections %}{% set _ = links.append(('#hakkimizda','Hakkımızda')) %}{% endif %}
{% if 'products' in sections %}{% set _ = links.append(('#urunler','Ürünler')) %}{% endif %}
{% if 'gallery' in sections %}{% set _ = links.append(('#galeri','Galeri')) %}{% endif %}
{% set _ = links.append(('#iletisim','İletişim')) %}
{{ p.nav(links) }}

{% for s in sections %}
{% if s == 'banner' %}
<section class="hero">
  <div class="mesh"></div>
  {% if banner.image %}<div class="hero-bg"><img src="/{{ banner.image }}" alt="" fetchpriority="high"></div>{% endif %}
  <div class="wrap hero-in">
    {% if site.slogan %}<span class="eyebrow">{{ site.slogan }}</span>{% endif %}
    <h1><span class="hl">{{ banner.headline }}</span></h1>
    <p class="sub">{{ banner.subline }}</p>
    <div class="cta">
      {% if banner.cta_text %}<a class="btn btn--lg" href="{{ banner.cta_link }}">{{ banner.cta_text }}</a>{% endif %}
      {% if banner.cta2_text %}<a class="btn btn--lg btn--ghost" href="{{ banner.cta2_link }}" {% if 'http' in banner.cta2_link %}target="_blank" rel="noopener"{% endif %}>{{ banner.cta2_text }}</a>{% endif %}
    </div>
    {% if about.stats %}
    <div class="badge-row">
      {% for st in about.stats %}<span>{{ st.value }} {{ st.label }}</span>{% endfor %}
    </div>
    {% endif %}
  </div>
</section>
{% if services %}
<div class="marquee" aria-hidden="true">
  <ul>
    {% for i in range(2) %}{% for sv in services %}<li>{{ sv.title }}</li>{% endfor %}{% endfor %}
  </ul>
</div>
{% endif %}

{% elif s == 'services' %}
<section class="sec" id="hizmetler">
  <div class="wrap">
    <div class="rv" style="max-width:640px;margin-bottom:clamp(30px,4vw,54px)">
      <span class="eyebrow">Ne yapıyoruz</span>
      <h2>Hizmetlerimiz</h2>
    </div>
    <div class="grid g3">
      {% for sv in services %}
      <article class="card svc rv">
        <span class="n">{{ '%02d'|format(loop.index) }}</span>
        {% if sv.image %}<img src="/{{ sv.image }}" alt="{{ sv.title }}" loading="lazy">
        {% elif sv.icon %}<div class="ic">{{ sv.icon }}</div>{% endif %}
        <h3>{{ sv.title }}</h3>
        <p>{{ sv.text }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{% elif s == 'about' %}
<section class="sec" id="hakkimizda">
  <div class="wrap split">
    <div class="rv">
      <span class="eyebrow">Biz kimiz</span>
      <h2 style="margin-bottom:18px">{{ about.title }}</h2>
      <p class="lead" style="white-space:pre-line;margin-bottom:30px">{{ about.text }}</p>
      {% if tel %}<a class="btn" href="{{ tel }}">Bizi arayın</a>{% endif %}
    </div>
    {% if about.image %}
    <div class="split-img rv"><img src="/{{ about.image }}" alt="{{ about.title }}" loading="lazy"></div>
    {% elif about.stats %}
    <div class="stats rv">
      {% for st in about.stats %}<div><b>{{ st.value }}</b><span>{{ st.label }}</span></div>{% endfor %}
    </div>
    {% endif %}
  </div>
  {% if about.image and about.stats %}
  <div class="wrap" style="margin-top:clamp(30px,4vw,58px)">
    <div class="stats rv">
      {% for st in about.stats %}<div><b>{{ st.value }}</b><span>{{ st.label }}</span></div>{% endfor %}
    </div>
  </div>
  {% endif %}
</section>

{% elif s == 'products' %}
<section class="sec" id="urunler">
  <div class="wrap">
    <div class="rv" style="max-width:640px;margin-bottom:clamp(30px,4vw,54px)">
      <span class="eyebrow">Vitrin</span>
      <h2>Ürünlerimiz</h2>
    </div>
    {% if products|length >= 8 %}
    <div class="searchbar rv">
      <input type="search" id="urunAra" placeholder="Ürün ara…" aria-label="Ürün ara"
             autocomplete="off" enterkeyhint="search">
      <span id="araSonuc"></span>
    </div>
    {% endif %}
    <div class="plist" id="plist">
      {% for pr in products %}
      <article class="card pcard rv" data-ara="{{ (pr.name ~ ' ' ~ pr.desc ~ ' ' ~ pr.category)|lower }}">
        <a class="ph" href="/urun/{{ pr.slug }}/" aria-label="{{ pr.name }} detayı">
          {% if pr.badge %}<span class="tag">{{ pr.badge }}</span>{% endif %}
          {% if pr.images %}
          <img src="/{{ pr.images[0] }}" alt="{{ pr.name }}" loading="lazy">
          {% if pr.images|length > 1 %}<span class="imgcount">📷 {{ pr.images|length }}</span>{% endif %}
          {% else %}<div class="noimg">🖼</div>{% endif %}
        </a>
        <div class="pb">
          <h3><a href="/urun/{{ pr.slug }}/">{{ pr.name }}</a></h3>
          {% if pr.desc %}<p class="desc">{{ pr.desc }}</p>{% endif %}
          {% if pr.price %}<div class="price">{{ pr.price }} {{ pr.currency }}</div>{% endif %}
          {% set hedef = pr.link or whatsapp or tel %}
          {% if hedef %}
          <a class="btn btn--accent" style="margin-top:6px" href="{{ hedef }}"
             {% if 'http' in hedef %}target="_blank" rel="noopener"{% endif %}>Bilgi al</a>
          {% endif %}
        </div>
      </article>
      {% endfor %}
      <p class="empty-note" id="araBos" hidden>Aramanıza uyan ürün bulunamadı.</p>
    </div>
  </div>
</section>

{% elif s == 'gallery' %}
<section class="sec" id="galeri">
  <div class="wrap">
    <div class="rv" style="max-width:640px;margin-bottom:clamp(30px,4vw,54px)">
      <span class="eyebrow">Çalışmalarımız</span>
      <h2>Galeri</h2>
    </div>
    <div class="gal rv">
      {% for g in gallery %}
      <figure>
        <img class="zoom" src="/{{ g.image }}" alt="{{ g.caption or 'Galeri görseli' }}" loading="lazy">
        {% if g.caption %}<figcaption>{{ g.caption }}</figcaption>{% endif %}
      </figure>
      {% endfor %}
    </div>
  </div>
</section>

{% elif s == 'contact' %}
<div class="wrap" style="margin-top:clamp(30px,5vw,60px)">
  <div class="band rv">
    <h2>{{ site.slogan or 'Hemen başlayalım' }}</h2>
    <p>Ücretsiz keşif ve fiyat teklifi için bize ulaşın.</p>
    {% if tel %}<a class="btn btn--lg" href="{{ tel }}">{{ contact.phone or 'Bizi arayın' }}</a>{% endif %}
  </div>
</div>
{{ p.contact_section() }}
{% endif %}
{% endfor %}

{{ p.footer() }}
{{ p.whatsapp_float() }}
{{ p.scripts() }}
</body>
</html>
