{%- macro footer() -%}
<footer class="foot">
  <div class="wrap foot-in">
    <div>
      <div class="brand" style="margin-bottom:8px">
        {% if site.logo %}<img src="/{{ site.logo }}" alt="{{ site.title }}">
        {% else %}<span class="dot">{{ (site.title or 'S')[0]|upper }}</span>{% endif %}
        <span>{{ site.name or site.title }}</span>
      </div>
      <small>© {{ year }} {{ site.title }}. Tüm hakları saklıdır.</small>
    </div>
    {% if socials %}<div class="socials">{{ social_links() }}</div>{% endif %}
    <a class="credit" href="https://wizaicorp.com" target="_blank" rel="noopener">WizaiCorp ile yapıldı</a>
  </div>
</footer>
{%- endmacro -%}


{%- macro scripts() -%}
<div class="lightbox" id="lb">
  <button class="lb-nav prev" id="lbPrev" aria-label="Önceki">‹</button>
  <img src="" alt="">
  <button class="lb-nav next" id="lbNext" aria-label="Sonraki">›</button>
  <span class="lb-count" id="lbCount"></span>
</div>
<script>
(function(){
  var nav=document.getElementById('nav');
  var onScroll=function(){nav.classList.toggle('stuck',window.scrollY>24)};
  onScroll();addEventListener('scroll',onScroll,{passive:true});

  var t=document.getElementById('navToggle'),l=document.getElementById('navLinks');
  if(t&&l){
    t.addEventListener('click',function(){
      var open=l.classList.toggle('open');
      t.setAttribute('aria-expanded',open?'true':'false');
    });
    l.addEventListener('click',function(e){
      if(e.target.tagName==='A')l.classList.remove('open');
    });
  }

  var els=document.querySelectorAll('.rv');
  if(!('IntersectionObserver' in window)){
    els.forEach(function(el){el.classList.add('in')});
  }else{
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(en,i){
        if(en.isIntersecting){
          var el=en.target;
          setTimeout(function(){el.classList.add('in')},(el.dataset.delay||0)*1);
          io.unobserve(el);
        }
      });
    },{rootMargin:'0px 0px -8% 0px',threshold:.08});
    els.forEach(function(el,i){
      var p=el.parentElement;
      if(p&&p.children.length>1&&p.children.length<13){el.dataset.delay=i%6*70}
      io.observe(el);
    });
  }

  /* Buyutulmus gorsel. Bir urunun birden fazla fotografi varsa ana gorsele
     data-imgs ile hepsi bagli oluyor; burada oklarla gezilebiliyor. */
  var lb=document.getElementById('lb'),lbi=lb.querySelector('img'),
      lbc=document.getElementById('lbCount'),
      prev=document.getElementById('lbPrev'),next=document.getElementById('lbNext'),
      list=[],idx=0;

  function show(i){
    if(!list.length)return;
    idx=(i+list.length)%list.length;
    lbi.src=list[idx];
    var many=list.length>1;
    prev.hidden=next.hidden=!many;
    lbc.hidden=!many;
    lbc.textContent=(idx+1)+' / '+list.length;
  }
  function open(el){
    var d=el.getAttribute('data-imgs');
    list=d?d.split('|').filter(Boolean):[el.currentSrc||el.src];
    lbi.alt=el.alt||'';
    show(0);
    lb.classList.add('on');
    document.body.style.overflow='hidden';
  }
  function close(){lb.classList.remove('on');document.body.style.overflow=''}

  document.addEventListener('click',function(e){
    var z=e.target.closest('.zoom');
    if(z){open(z);return}
    if(e.target===prev){show(idx-1);return}
    if(e.target===next){show(idx+1);return}
    if(e.target.closest('.lightbox'))close();
  });
  addEventListener('keydown',function(e){
    if(!lb.classList.contains('on'))return;
    if(e.key==='Escape')close();
    if(e.key==='ArrowLeft')show(idx-1);
    if(e.key==='ArrowRight')show(idx+1);
  });

  /* Urun arama. Kategori filtresiyle birlikte calisir: gorunur olmak icin
     urunun hem secili kategoriye hem arama metnine uymasi gerekiyor. */
  var ara=document.getElementById('urunAra');
  if(ara){
    var kartlar=[].slice.call(document.querySelectorAll('[data-ara]')),
        bos=document.getElementById('araBos'),
        bilgi=document.getElementById('araSonuc'),zaman;

    /* Turkce harfleri sadelestir: 'sise' yazan 'şişe'yi de bulsun */
    function sadelestir(t){
      return (t||'').toLocaleLowerCase('tr')
        .replace(/ı/g,'i').replace(/ş/g,'s').replace(/ğ/g,'g')
        .replace(/ü/g,'u').replace(/ö/g,'o').replace(/ç/g,'c');
    }
    kartlar.forEach(function(k){k._ara=sadelestir(k.getAttribute('data-ara'))});

    function calistir(){
      var q=sadelestir(ara.value.trim()),
          kelimeler=q?q.split(/\s+/):[],gorunen=0;
      kartlar.forEach(function(k){
        var uyar=kelimeler.every(function(w){return k._ara.indexOf(w)>-1});
        k.dataset.aramaUydu=uyar?'1':'0';
        var kategoriUydu=k.dataset.katGizli!=='1';
        k.classList.toggle('hide',!(uyar&&kategoriUydu));
        if(uyar&&kategoriUydu)gorunen++;
      });
      if(bos)bos.hidden=gorunen>0;
      if(bilgi)bilgi.textContent=q?(gorunen+' ürün bulundu'):'';
    }
    ara.addEventListener('input',function(){
      clearTimeout(zaman);zaman=setTimeout(calistir,120);
    });
    window.__urunAramaCalistir=calistir;   /* kategori filtresi de tetikleyebilsin */
  }
})();
</script>
{%- endmacro -%}
