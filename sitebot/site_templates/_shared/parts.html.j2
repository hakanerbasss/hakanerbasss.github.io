{# Tüm şablonların paylaştığı parçalar. "with context" ile import edilir. #}

{%- macro head(extra_css="") -%}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{{ site.title }}{% if site.slogan %} | {{ site.slogan }}{% endif %}</title>
<meta name="description" content="{{ site.description }}">
{% if d.seo.keywords %}<meta name="keywords" content="{{ d.seo.keywords }}">{% endif %}
<meta name="theme-color" content="{{ theme.bg }}">
<link rel="canonical" href="https://{{ domain }}/">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ site.title }}">
<meta property="og:description" content="{{ site.description }}">
<meta property="og:url" content="https://{{ domain }}/">
{% set og = d.seo.og_image or banner.image or site.logo %}
{% if og %}<meta property="og:image" content="https://{{ domain }}/{{ og }}">{% endif %}
<meta name="twitter:card" content="summary_large_image">
{% if site.favicon %}
<link rel="icon" href="/{{ site.favicon }}">
{% else %}
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='22' fill='{{ theme.primary|urlencode }}'/><text x='50' y='68' font-size='56' font-family='sans-serif' font-weight='bold' text-anchor='middle' fill='{{ theme.on_primary|urlencode }}'>{{ (site.title or 'S')[0]|upper }}</text></svg>">
{% endif %}
{# Yazi tipi dosyasi render'i BLOKLAMAMALI: yavas baglantida ya da Google
   Fonts erisilemedigi durumda sayfa bembeyaz bekliyordu. Once sistem yazi
   tipiyle ciziliyor, ozel yazi tipi gelince kendiliginden yerine geciyor. #}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" media="print" onload="this.media='all'"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800;900&family=Space+Grotesk:wght@400;600;700&family=Nunito:wght@400;700;900&display=swap">
<noscript><link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800;900&family=Space+Grotesk:wght@400;600;700&family=Nunito:wght@400;700;900&display=swap"></noscript>
<script type="application/ld+json">
{{ ld_json() }}
</script>
<style>
{% include "_shared/core.css.j2" %}
{{ extra_css }}
</style>
{%- endmacro -%}


{%- macro ld_json() -%}
{
  "@context":"https://schema.org",
  "@type":"LocalBusiness",
  "name":{{ site.title|tojson }},
  "description":{{ site.description|tojson }},
  "url":"https://{{ domain }}/"
  {%- if contact.phone %},"telephone":{{ contact.phone|tojson }}{% endif %}
  {%- if contact.email %},"email":{{ contact.email|tojson }}{% endif %}
  {%- if contact.address %},"address":{"@type":"PostalAddress","streetAddress":{{ contact.address|tojson }}}{% endif %}
  {%- if socials %},"sameAs":[{% for s in socials %}{{ s.url|tojson }}{{ "," if not loop.last }}{% endfor %}]{% endif %}
}
{%- endmacro -%}


{%- macro nav(links) -%}
<header class="nav" id="nav">
  <a href="#top" class="brand">
    {% if site.logo %}<img src="/{{ site.logo }}" alt="{{ site.title }}">
    {% else %}<span class="dot">{{ (site.title or 'S')[0]|upper }}</span>{% endif %}
    <span>{{ site.name or site.title }}</span>
  </a>
  <button class="nav-toggle" id="navToggle" aria-label="Menü" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
  <nav class="nav-links" id="navLinks">
    {% for href, label in links %}<a href="{{ href }}">{{ label }}</a>{% endfor %}
    {% if tel %}<a href="{{ tel }}" class="btn">{{ contact.phone }}</a>{% endif %}
  </nav>
</header>
{%- endmacro -%}


{%- macro contact_section() -%}
<section class="sec" id="iletisim">
  <div class="wrap">
    <div class="rv" style="margin-bottom:38px">
      <span class="eyebrow">İletişim</span>
      <h2>Bize ulaşın</h2>
      <p class="lead">Sorularınız için arayın, yazın ya da uğrayın.</p>
    </div>
    <div class="contact-grid">
      <div class="rv">
        {% if contact.phone %}
        <a class="info-row" href="{{ tel }}">
          <span class="ic">📞</span><span><b>Telefon</b><span>{{ contact.phone }}</span></span>
        </a>
        {% endif %}
        {% if whatsapp %}
        <a class="info-row" href="{{ whatsapp }}" target="_blank" rel="noopener">
          <span class="ic">💬</span><span><b>WhatsApp</b><span>Hemen mesaj gönder</span></span>
        </a>
        {% endif %}
        {% if contact.email %}
        <a class="info-row" href="mailto:{{ contact.email }}">
          <span class="ic">✉️</span><span><b>E-posta</b><span>{{ contact.email }}</span></span>
        </a>
        {% endif %}
        {% if contact.address %}
        <div class="info-row">
          <span class="ic">📍</span><span><b>Adres</b><span>{{ contact.address }}</span></span>
        </div>
        {% endif %}
        {% if contact.hours %}
        <div class="info-row">
          <span class="ic">🕐</span>
          <span style="flex:1"><b>Çalışma Saatleri</b>
            <ul class="hours" style="margin-top:9px">
              {% for h in contact.hours %}<li>{{ h.day }} <span>{{ h.time }}</span></li>{% endfor %}
            </ul>
          </span>
        </div>
        {% endif %}
        {% if socials %}<div class="socials" style="margin-top:22px">{{ social_links() }}</div>{% endif %}
      </div>

      <div class="rv">
        {% if map_src %}
        <div class="map">
          <iframe src="{{ map_src }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
                  title="Konum haritası" allowfullscreen></iframe>
        </div>
        {% elif contact.form_endpoint %}
        {{ contact_form() }}
        {% endif %}
      </div>
    </div>

    {% if map_src and contact.form_endpoint %}
    <div class="rv" style="margin-top:clamp(24px,4vw,52px);max-width:640px">
      {{ contact_form() }}
    </div>
    {% endif %}
  </div>
</section>
{%- endmacro -%}


{%- macro contact_form() -%}
<form class="card" action="{{ contact.form_endpoint }}" method="POST" style="padding:clamp(22px,3vw,34px)">
  <h3 style="margin-bottom:18px">Mesaj gönderin</h3>
  <div class="field"><label for="f-ad">Adınız</label>
    <input id="f-ad" name="ad" required autocomplete="name"></div>
  <div class="field"><label for="f-tel">Telefon</label>
    <input id="f-tel" name="telefon" type="tel" required autocomplete="tel"></div>
  <div class="field"><label for="f-msg">Mesajınız</label>
    <textarea id="f-msg" name="mesaj" required></textarea></div>
  <button class="btn btn--accent" type="submit" style="width:100%">Gönder</button>
  <p class="form-note">Mesajınız doğrudan e-postamıza iletilir.</p>
</form>
{%- endmacro -%}


{%- macro social_links() -%}
{% for s in socials %}
<a href="{{ s.url }}" target="_blank" rel="noopener" aria-label="{{ s.kind }}" title="{{ s.kind }}">
  {{ social_icon(s.kind) }}
</a>
{% endfor %}
{%- endmacro -%}


