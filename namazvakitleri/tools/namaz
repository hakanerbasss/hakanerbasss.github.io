#!/data/data/com.termux/files/usr/bin/bash
# Termux "namaz" komutu — GitHub'dan guncel surumu ceker, projeyi gunceller.
# Kurulum: cp tools/namaz $PREFIX/bin/namaz && chmod +x $PREFIX/bin/namaz
set -e
BRANCH="claude/namaz-vakitleri-app-ck3cx4"
REPO="https://github.com/hakanerbasss/hakanerbasss.github.io.git"
SYNC="$HOME/repo-sync"
PROJ="$HOME/namazvakitleri"

if [ ! -d "$SYNC/.git" ]; then
    echo ">> Ilk kurulum: depo klonlaniyor..."
    git clone --depth 1 --branch "$BRANCH" "$REPO" "$SYNC"
else
    echo ">> GitHub'dan guncel surum cekiliyor..."
    git -C "$SYNC" fetch origin "$BRANCH"
    git -C "$SYNC" reset --hard FETCH_HEAD
fi

echo ">> Proje uzerine yaziliyor: $PROJ"
mkdir -p "$PROJ"
if command -v rsync >/dev/null 2>&1; then
    rsync -a "$SYNC/namazvakitleri/" "$PROJ/"
else
    cp -rf "$SYNC/namazvakitleri/." "$PROJ/"
fi

echo ""
git -C "$SYNC" log -1 --format=">> Son guncelleme: %s (%cr)"
echo ">> HAZIR. Build: tos 15 d (APK) | tos 15 2 (imzali AAB)"
