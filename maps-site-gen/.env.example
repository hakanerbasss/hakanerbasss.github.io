# Claude API - web sitesi içeriği AI ile üretmek için (opsiyonel)
# https://console.anthropic.com adresinden alın
ANTHROPIC_API_KEY=sk-ant-...

# Çıktı klasörü (varsayılan: output)
OUTPUT_DIR=output

# Tarayıcı görünür mü? true=arka planda, false=görünür (debug için)
HEADLESS=true

# Ekstra yavaşlama (ms) - anti-detection
SLOW_MO=50

# Scraping limitleri
MAX_BUSINESSES=20
REQUEST_DELAY=2.0

# GitHub Pages deploy (opsiyonel)
GITHUB_TOKEN=ghp_...
GITHUB_REPO=kullanici/repo-adi
