# ── Claude AI (opsiyonel) ──────────────────────────────────────────
# https://console.anthropic.com → API Keys
# Yoksa şablon içerik kullanılır, yine de çalışır
ANTHROPIC_API_KEY=

# ── GitHub Pages deploy (opsiyonel) ───────────────────────────────
# https://github.com/settings/tokens → "repo" kapsamı seç
GITHUB_TOKEN=
# Örn: kullanici/siteler
GITHUB_REPO=

# ── Uygulama ayarları ─────────────────────────────────────────────
OUTPUT_DIR=output
HEADLESS=true
MAX_BUSINESSES=20
REQUEST_DELAY=2.5
FLASK_PORT=5000
# Sunucudan erişim için 0.0.0.0, sadece kendi için 127.0.0.1
FLASK_HOST=0.0.0.0
