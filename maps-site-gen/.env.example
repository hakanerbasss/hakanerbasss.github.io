# ── Pexels Fotoğraf API (opsiyonel, ücretsiz) ────────────────────
# https://www.pexels.com/api/ → Ücretsiz hesap aç, anında key alırsın (kredi kartı yok)
# Key yoksa Unsplash stok fotoğrafları kullanılır (otomatik)
PEXELS_API_KEY=

# ── Google Places API (opsiyonel ama önerilen) ────────────────────
# Yoksa Overpass/OSM kullanılır (ücretsiz, key gerektirmez)
# API key almak için: https://console.cloud.google.com
# → "Places API" aktifleştir → $200/ay ücretsiz kredi
GOOGLE_PLACES_API_KEY=

# ── DeepSeek AI (opsiyonel, ÖNERİLEN) ────────────────────────────
# İçerik üretmek için — çok ucuz, kredi kartı gerektirmez başlangıçta
# https://platform.deepseek.com → API Keys → Kayıt ol, key al
# (Anthropic'ten 10x daha ucuz, aynı kalite)
DEEPSEEK_API_KEY=

# ── Claude/Anthropic AI (opsiyonel, alternatif) ───────────────────
ANTHROPIC_API_KEY=

# ── GitHub Pages deploy (opsiyonel) ───────────────────────────────
# https://github.com/settings/tokens → "repo" yetkisi ver
GITHUB_TOKEN=
GITHUB_REPO=kullanici/repo-adi

# ── Uygulama ──────────────────────────────────────────────────────
OUTPUT_DIR=output
MAX_BUSINESSES=20
REQUEST_DELAY=1.0
FLASK_PORT=5000
FLASK_HOST=0.0.0.0
