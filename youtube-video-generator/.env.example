# DeepSeek LLM
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Supertonic TTS (HTTP servisi olarak çalışıyorsa)
TTS_URL=http://localhost:5500
TTS_SPEAKER=tr_speaker_0
# edge-tts veya supertonic  →  supertonic varsa "supertonic" yaz
TTS_BACKEND=edge-tts

# Pexels
PEXELS_API_KEY=...

# YouTube OAuth (Google Cloud Console'dan alın)
YOUTUBE_CLIENT_ID=...
YOUTUBE_CLIENT_SECRET=...
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/callback

# Opsiyonel: özel font yolu (Türkçe karakter desteği için)
FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
